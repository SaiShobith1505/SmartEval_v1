# Server Config
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Security
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_REFRESH_SECRET=another_super_secret_refresh_key_change_me_in_production
BCRYPT_ROUNDS=12

# Database (Prisma / PostgreSQL)
DATABASE_URL="postgresql://smarteval:smarteval_dev_pass@localhost:5432/smarteval_db?schema=public"

# Redis (BullMQ / Caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage Abstraction
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=smarteval-docs
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000

# AI Provider Abstraction
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
VISION_MODEL=qwen2.5-vl:7b
EVALUATION_MODEL=qwen3:8b
VERIFICATION_MODEL=qwen2.5-coder:14b

# Confidence Threshold
QUESTION_MAPPING_CONFIDENCE_THRESHOLD=0.85
